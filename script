local function startAttack()
    if attacking then return end
    attacking = true
    attackThread = task.spawn(function()
        while attacking and active do
            if RE and RE.Parent then
                RE:FireServer("HoldAttack", {Bool = true, Type = "m1"})
            end
            task.wait(0.1)
        end
    end)
end

local function stopAttack()
    attacking = false
    if attackThread then 
        task.cancel(attackThread) 
        attackThread = nil 
    end
    if RE and RE.Parent then
        RE:FireServer("HoldAttack", {Bool = false, Type = "m1"})
    end
end

local function toggleStand()
    stopAttack()
