local function waitForOptions(dialogue, timeout)
    timeout = timeout or 5
    local start = os.clock()
    while os.clock() - start < timeout do
        if not dialogue or not dialogue.Parent then return nil end
        local frame = dialogue:FindFirstChild("Frame")
        local options = frame and frame:FindFirstChild("Options")
        if options then
            local buttons = {}
            for _, child in ipairs(options:GetChildren()) do
                if child.Name:match("Option%d+") then
                    local btn = child:FindFirstChild("TextButton")
                    if btn and btn.Visible and btn.Active then
                        table.insert(buttons, btn)
                    end
                end
            end
            if #buttons > 0 then return buttons end
        end
        task.wait(0.05)
    end
    return nil
end

local function pressButton(button)
    if not button or not button.Parent then return false end
    return pcall(function()
        local connections = getconnections(button.MouseButton1Click)
        if connections and #connections > 0 then
            local func = connections[1].Function
            local info = debug.getinfo(func)
            for i = 1, info.nups do
                if debug.getupvalue(func, i) == "Option1" then
                    debug.setupvalue(func, i, true)
                    break
                end
            end
            func()
        end
    end)
end

local function useItemWithGUI(itemName)
    local char, _, backpack = updateCharacter()
    if not char or not backpack then return false end
    local tool = char:FindFirstChild(itemName) or backpack:FindFirstChild(itemName)
    if not tool then return false end
    
    local humanoid = char:FindFirstChild("Humanoid")
    if humanoid and tool.Parent == backpack then
        humanoid:EquipTool(tool)
        task.wait(0.5)
    end
    
    tool:Activate()
    
    local dialogue
    for _ = 1, 20 do
        dialogue = player.PlayerGui:FindFirstChild("DialogueGui")
        if dialogue then break end
        task.wait(0.1)
    end
    if not dialogue then return false end
    
    local buttons = waitForOptions(dialogue, 10)
    if not buttons or #buttons == 0 then return false end
    
    while dialogue and dialogue.Parent do
        local currentButtons = waitForOptions(dialogue, 1)
        if currentButtons then
            for _, btn in ipairs(currentButtons) do
                if btn and btn.Parent and btn.Visible and btn.Active then
                    pressButton(btn)
                    task.wait(0.3)
                    if not dialogue.Parent then break end
                end
            end
        else
            task.wait(0.2)
        end
    end
    task.wait(1)
    return true
end

