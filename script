    local function getLevel() return player.PlayerStats.Level.Value end

    local function learnSkills()
        if not RF then return end
        for _, data in ipairs(skills) do
            pcall(function() RF:InvokeServer("LearnSkill", data) end)
        end
    end

    local function farmItem(name)
        local hasItems = false
        for itemName, prompts in pairs(itemFarmTable) do
            if itemName == name and #prompts > 0 then
                hasItems = true
                break
            end
        end
        
        if not hasItems then
            return false
        end
        
        if not isFarmingItems then
            local wasFarming = isFarmingItems
            isFarmingItems = true
            
            local oldSelection = {}
            for item, selected in pairs(selectedItems) do
                oldSelection[item] = selected
                selectedItems[item] = (item == name)
            end
            
            farmThread = task.spawn(startItemFarmLoop)
            
            local timeout = 30
            local startTime = os.clock()
            while os.clock() - startTime < timeout do
                if (backpack and backpack:FindFirstChild(name)) or (character and character:FindFirstChild(name)) then
                    break
                end
                task.wait(0.5)
            end
            
            isFarmingItems = wasFarming
            for item, selected in pairs(oldSelection) do
                selectedItems[item] = selected
            end
            
            if farmThread then
                task.cancel(farmThread)
                farmThread = nil
            end
            
            if (backpack and backpack:FindFirstChild(name)) or (character and character:FindFirstChild(name)) then
                return true
            else
                return false
            end
        end
        
        return false
    end

    local function useItemWithGUI(itemName)
        if not character or not backpack then return false end
        local tool = character:FindFirstChild(itemName) or backpack:FindFirstChild(itemName)
        if not tool then return false end
        
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid and tool.Parent == backpack then
            humanoid:EquipTool(tool)
            task.wait(0.5)
        end
        
        tool:Activate()
        
        local dialogue
        for _ = 1, 20 do
            dialogue = player.PlayerGui:FindFirstChild("DialogueGui")
            if dialogue then break end
            task.wait(0.1)
        end
        if not dialogue then return false end
        
        local buttons = waitForOptions(dialogue, 10)
        if not buttons or #buttons == 0 then return false end
        
        while dialogue and dialogue.Parent do
            local currentButtons = waitForOptions(dialogue, 1)
            if currentButtons then
                for _, btn in ipairs(currentButtons) do
                    if btn and btn.Parent and btn.Visible and btn.Active then
                        pressButton(btn)
                        task.wait(0.3)
                        if not dialogue.Parent then break end
                    end
                end
            else
                task.wait(0.2)
            end
        end
        
        task.wait(1)
        local stats = player:FindFirstChild("PlayerStats")
        return stats and stats:FindFirstChild("Stand") and stats.Stand.Value ~= "None"
    end

    local function useArrow() return useItemWithGUI("Mysterious Arrow") end
    local function useRoka() return useItemWithGUI("Rokakaka") end

