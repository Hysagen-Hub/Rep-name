local function farmSpecificItem(itemName, timeout)
    timeout = timeout or 30
    local wasFarming = isFarmingItems
    isFarmingItems = true
    
    local oldSelection = {}
    for item, selected in pairs(selectedItems) do
        oldSelection[item] = selected
        selectedItems[item] = (item == itemName)
    end
    
    local tempThread = task.spawn(startItemFarmLoop)
    local startTime = os.clock()
    while os.clock() - startTime < timeout do
        local char, _, backpack = updateCharacter()
        if (backpack and backpack:FindFirstChild(itemName)) or (char and char:FindFirstChild(itemName)) then
            break
        end
        task.wait(0.5)
    end
    
    isFarmingItems = wasFarming
    for item, selected in pairs(oldSelection) do selectedItems[item] = selected end
    task.cancel(tempThread)
    
    local char, _, backpack = updateCharacter()
    return (backpack and backpack:FindFirstChild(itemName)) or (char and char:FindFirstChild(itemName))
end

local function startStandFarmLoop()
    while isStandFarming do
        if not selectedTargetStand then
            isStandFarming = false
            if standFarmBtn then
                standFarmBtn.Text = "🎯 STAND FARM : ВЫКЛ"
                standFarmBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
            end
            break
        end

        local stats = player:FindFirstChild("PlayerStats")
        if not stats or not stats:FindFirstChild("Stand") then
            task.wait(1)
            continue
        end

        local currentStand = stats.Stand.Value
        if currentStand == selectedTargetStand then
            isStandFarming = false
            if standFarmBtn then
                standFarmBtn.Text = "🎯 STAND FARM : ВЫКЛ"
                standFarmBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
            end
            if isFarmingItems then stopItemFarm() end
            break
        end

        local char, _, backpack = updateCharacter()
        if currentStand ~= "None" then
            local hasRoka = (backpack and backpack:FindFirstChild("Rokakaka")) or (char and char:FindFirstChild("Rokakaka"))
            if not hasRoka then
                farmSpecificItem("Rokakaka")
                if stats.Stand.Value == selectedTargetStand then
                    isStandFarming = false
                    if standFarmBtn then
                        standFarmBtn.Text = "🎯 STAND FARM : ВЫКЛ"
                        standFarmBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
                    end
                    if isFarmingItems then stopItemFarm() end
                    break
                end
            end
            useItemWithGUI("Rokakaka")
            task.wait(1.5)
        else
            learnWorthiness()
            task.wait(0.3)

            local itemToUse = nil
            if table.find(ARROW_STANDS, selectedTargetStand) then
                itemToUse = "Mysterious Arrow"
            elseif table.find(RIB_STANDS, selectedTargetStand) then
                itemToUse = "Rib Cage of The Saint's Corpse"
            end

            if itemToUse then
                local hasItem = (backpack and backpack:FindFirstChild(itemToUse)) or (char and char:FindFirstChild(itemToUse))
                if not hasItem then
                    farmSpecificItem(itemToUse)
                    if stats.Stand.Value == selectedTargetStand then
                        isStandFarming = false
                        if standFarmBtn then
                            standFarmBtn.Text = "🎯 STAND FARM : ВЫКЛ"
                            standFarmBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
                        end
                        if isFarmingItems then stopItemFarm() end
                        break
                    end
                end
                useItemWithGUI(itemToUse)
                task.wait(1.5)
            else
                task.wait(1)
            end
        end
        task.wait(0.5)
    end
end

