                        if #_G.ItemESP_Items[itemName] == 0 then
                            _G.ItemESP_Items[itemName] = nil
                        end
                    end
                end
            end)
        end
    end
    
    RegisterAllItemsForESP()
    task.wait(0.3)
    UpdateESP()
    
    task.spawn(function()
        while _G.ItemESP_Active do
            task.wait(2)
            UpdateESP()
        end
    end)
    
    espInstance = {
        Disable = function()
            _G.ItemESP_Active = false
            if getgenv().item_added_esp_conn then
                getgenv().item_added_esp_conn:Disconnect()
                getgenv().item_added_esp_conn = nil
            end
            if getgenv().item_removed_esp_conn then
                getgenv().item_removed_esp_conn:Disconnect()
                getgenv().item_removed_esp_conn = nil
            end
