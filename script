            local hum = character:FindFirstChildOfClass("Humanoid") or character:FindFirstChild("Humanoid")
            if hum then
                hum.Health = 0
            end
        end
        local newChar = player.CharacterAdded:Wait()
        updateCharacterMain(newChar)
        task.wait(1)
    end

    if player.Character then updateCharacterMain(player.Character) end

    local function RefreshQuests()
        if QuestsRF then
            pcall(function() QuestsRF:InvokeServer({"ReturnData"}) end)
        end
    end

    local function EndDialogue(NPC, Dialogue, Option)
        if RE then
            RE:FireServer("EndDialogue", {
                NPC = NPC,
                Dialogue = Dialogue,
                Option = Option or "Option1"
            })
        end
    end

    local function getQuestProgress()
        local stats = player:FindFirstChild("PlayerStats")
        if not stats then return {Progress = 0, Max = 0, Name = "None"} end
        
        return {
            Progress = stats:FindFirstChild("QuestProgress") and stats.QuestProgress.Value or 0,
            Max = stats:FindFirstChild("QuestMaxProgress") and stats.QuestMaxProgress.Value or 0,
            Name = stats:FindFirstChild("Quest") and stats.Quest.Value or "None"
        }
    end

    local function waitForOptions(dialogue, timeout)
        timeout = timeout or 5
        local start = os.clock()
        
        while os.clock() - start < timeout do
            if not dialogue or not dialogue.Parent then return nil end
            local frame = dialogue:FindFirstChild("Frame")
            local options = frame and frame:FindFirstChild("Options")
            
            if options then
                local buttons = {}
                for _, child in ipairs(options:GetChildren()) do
                    if child.Name:match("Option%d+") then
                        local btn = child:FindFirstChild("TextButton")
                        if btn and btn.Visible and btn.Active then
                            table.insert(buttons, btn)
                        end
                    end
                end
                if #buttons > 0 then return buttons end
            end
            task.wait(0.05)
        end
        return nil
    end

    local function pressButton(button)
        if not button or not button.Parent then return false end
        return pcall(function()
            local connections = getconnections(button.MouseButton1Click)
            if connections and #connections > 0 then
                local func = connections[1].Function
                local info = debug.getinfo(func)
                for i = 1, info.nups do
                    if debug.getupvalue(func, i) == "Option1" then
                        debug.setupvalue(func, i, true)
                        break
                    end
                end
                func()
            end
        end)
    end

    local function endDialogue(story, dialogue)
        RefreshQuests()
        task.wait(0.1)
        EndDialogue(story, dialogue, "Option1")
        task.wait(0.1)
        RefreshQuests()
    end

    local function travelMainAnchored(pos)
        if not rootPart or not rootPart.Parent then return false end
        
        local wasAnchoredMain = rootPart.Anchored
        rootPart.Anchored = true
        
        local success = false
        
        pcall(function()
            local start = rootPart.Position
            local dir = (pos - start)
            local dist = dir.Magnitude
            local steps = math.max(1, math.ceil(dist / 50))
            local stepVec = dir / steps
            
            for _ = 1, steps do
                if not active or not rootPart or not rootPart.Parent then return end
                rootPart.CFrame = CFrame.new(rootPart.Position + stepVec)
                task.wait(0.05)
            end
            rootPart.CFrame = CFrame.new(pos)
            task.wait(0.05)
            success = true
        end)
        
        rootPart.Anchored = wasAnchoredMain
        
        return success
    end

    local function findNPC(name)
        local living = Workspace:FindFirstChild("Living")
        if not living then return nil end
        for _, npc in ipairs(living:GetChildren()) do
            if npc.Name == name then
                local hrp = npc:FindFirstChild("HumanoidRootPart")
                local hp = npc:FindFirstChild("Health")
                if hrp and hp and hp.Value > 0 then return npc end
