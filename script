                        while active and getLevel() < 35 do
                            endDialogue("Doppio", "Dialogue3")
                            endDialogue("Doppio", "Dialogue5")
                            if not active then break end
                            farmWithStand("DIO")
                            task.wait(0.5)
                        end
                        task.wait(1)
                        level = getLevel()
                    end
                    
                    if level >= 35 and level < 45 then
                        while active and getLevel() < 45 do
                            endDialogue("Dio", "Dialogue4")
                            endDialogue("Dio", "Dialogue6")
                            if not active then break end
                            farmWithStand("Jotaro")
                            task.wait(0.5)
                        end
                        task.wait(1)
                        level = getLevel()
                    end
                    
                    if level == 45 then
                        endDialogue("Prestige", "Dialogue2")
                        wait(5)
                        prestige = getPrestige()
                        level = getLevel()
                    end
                end
            end
            if prestige == 3 then
                if level == 1 then
                    endDialogue("Storyline #1", "Dialogue2")
                    farmNPCs("Security Guard")
                end
                
                local stand = nil
                while not stand and active do
                    stand = getGoodStand()
                    task.wait(1)
                end
                
                if stand and not badStands[stand] then
                    task.wait(1)
                    level = getLevel()
                    if level == 3 then
                        endDialogue("Storyline #1", "Dialogue6")
                        task.wait(0.1)
                        endDialogue("Storyline #2", "Dialogue3")
                        task.wait(1)
                        level = getLevel()
                    end
                    
                    if level == 5 then
                        endDialogue("Storyline #3", "Dialogue3")
                        task.wait(0.1)
                        farmWithStand("Leaky Eye Luca")
                        task.wait(0.1)
                        task.wait(1)
                        level = getLevel()
                    end

                    if level == 8 then
                        endDialogue("Storyline #3", "Dialogue6")
                        task.wait(0.1)
                        farmWithStand("Bucciarati")
                        task.wait(1)
                        level = getLevel()
                    end
                    
                    if level == 11 then
                        endDialogue("Storyline #4", "Dialogue3")
                        endDialogue("Storyline #5", "Dialogue5")
                        task.wait(1)
                        level = getLevel()
                    end
                    
                    if level == 12 then
                        endDialogue("Storyline #6", "Dialogue5")
                        endDialogue("Storyline #7", "Dialogue5")
                        endDialogue("Storyline #8", "Dialogue4")
                        task.wait(1)
                        level = getLevel()
                    end
                    
                    if level == 13 then
                        endDialogue("Storyline #9", "Dialogue7")
                        endDialogue("Storyline #10", "Dialogue6")
                        endDialogue("Storyline #11", "Dialogue8")
                        task.wait(1)
                        level = getLevel()
                    end
                    
                    if level == 15 then
                        task.wait(0.1)
                        farmWithStand("Fugo")
                        task.wait(1)
                        level = getLevel()
                    end
                    
                    if level == 19 then
                        endDialogue("Storyline #11", "Dialogue11")
                        task.wait(0.1)
                        farmWithStand("Pesci")
                        task.wait(1)
                        level = getLevel()
                    end
                    
                    if level == 23 then
                        endDialogue("Storyline #12", "Dialogue3")
                        task.wait(0.1)
                        farmWithStand("Ghiaccio")
                        task.wait(1)
                        level = getLevel()
                    end
                    
                    if level == 27 then
                        endDialogue("Storyline #14", "Dialogue2")
                        task.wait(0.1)
                        farmWithStand("Diavolo")
                        endDialogue("Storyline #14", "Dialogue7")
                        resetCharacter()
                        task.wait(1)
                        level = getLevel()
                    end

                    if level >= 30 and level < 35 then
                        while active and getLevel() < 35 do
                            endDialogue("Doppio", "Dialogue3")
                            endDialogue("Doppio", "Dialogue5")
                            if not active then break end
                            farmWithStand("DIO")
                            task.wait(0.5)
                        end
                        task.wait(1)
                        level = getLevel()
                    end
                    
                    if level >= 35 and level < 50 then
                        while active and getLevel() < 50 do
                            endDialogue("Dio", "Dialogue4")
                            endDialogue("Dio", "Dialogue6")
                            if not active then break end
                            farmWithStand("Jotaro")
                            task.wait(0.5)
                        end
                        task.wait(1)
                        level = getLevel()
                    end
                    if level == 50 then 
                        stopAll() 
                    end
                end
            end
        end)
        
        if not success or not active then
            if not stopRequested and active then
                task.wait(2)
            else
                break
            end
        end
    end
end

