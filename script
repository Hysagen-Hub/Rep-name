local function setupTracker(tracker)
    local container = getItemContainer()
    if not container then return end
    
    local function addItem(item)
        if item.ClassName ~= "ProximityPrompt" then return end
        if not item.Parent:FindFirstChild("PointLight", true) then return end
        
        local itemName = item.ObjectText or "Unknown"
        if not tracker[itemName] then tracker[itemName] = {} end
        
        for _, v in pairs(tracker[itemName]) do
            if v == item then return end
        end
        
        table.insert(tracker[itemName], item)
        
        local key = tostring(item)
        if not trackedItems[key] then
            trackedItems[key] = true
            item.AncestryChanged:Connect(function()
                if not item:IsDescendantOf(workspace) then
                    if tracker[itemName] then
                        for i, v in pairs(tracker[itemName]) do
                            if v == item then
                                table.remove(tracker[itemName], i)
                                break
                            end
                        end
                        if #tracker[itemName] == 0 then tracker[itemName] = nil end
                    end
                    trackedItems[key] = nil
                end
            end)
        end
    end
    
    for _, descendant in ipairs(container:GetDescendants()) do
        if descendant.ClassName == "ProximityPrompt" then
            addItem(descendant)
        end
    end
    
    container.DescendantAdded:Connect(function(desc)
        if desc.ClassName == "ProximityPrompt" then
            addItem(desc)
        end
    end)
    
    container.DescendantRemoving:Connect(function(desc)
        if desc.ClassName == "ProximityPrompt" then
            local itemName = desc.ObjectText or "Unknown"
            if tracker[itemName] then
                for i, v in pairs(tracker[itemName]) do
                    if v == desc then
                        table.remove(tracker[itemName], i)
                        break
                    end
                end
                if #tracker[itemName] == 0 then tracker[itemName] = nil end
            end
        end
    end)
end

local function refreshTrackers()
    trackedItems = {}
    itemTracker = {}
    espTracker = {}
    setupTracker(itemTracker)
    setupTracker(espTracker)
end

local function getSpawnedItems()
    local available = {}
    for name, prompts in pairs(itemTracker) do
        if selectedItems[name] then
            for _, prompt in ipairs(prompts) do
                if prompt and prompt:IsDescendantOf(workspace) then
                    local parent = prompt.Parent
                    if parent and parent:IsDescendantOf(workspace) then
                        table.insert(available, {Name = name, Prompt = prompt, Model = parent})
                    end
                end
            end
        end
    end
    return available
end

local function activateRemoteEvents(model, prompt)
    if not model or not model:IsDescendantOf(workspace) then return false end
    local remoteEvents = {}
    for _, desc in ipairs(model:GetDescendants()) do
        if desc:IsA("RemoteEvent") then table.insert(remoteEvents, desc) end
    end
    if #remoteEvents > 0 then
        for _, remote in ipairs(remoteEvents) do
            if not isFarmingItems or not model.Parent then break end
            for i = 1, 3 do
                pcall(function()
                    remote:FireServer()
                    remote:FireServer(model)
                    remote:FireServer(prompt)
                end)
            end
        end
        return true
    end
    return false
end

local function collectItem(model, name, prompt)
    if not model or not model:IsDescendantOf(workspace) then return false end
    local distance = getDistanceToItem(model)
    if distance > ACTIVATION_DISTANCE then
        local part = model:IsA("BasePart") and model or model.PrimaryPart or model:FindFirstChildOfClass("BasePart")
        if part then
            if travelToPositionSmooth(part.Position + Vector3.new(0, 1, 0), 40) then
                task.wait(0.3)
                if getDistanceToItem(model) <= ACTIVATION_DISTANCE then
                    return activateRemoteEvents(model, prompt)
                end
            end
        end
        return false
    else
        return activateRemoteEvents(model, prompt)
    end
end

local function startItemFarmLoop()
    while isFarmingItems do
        if isStandFarming and selectedTargetStand then
            local stats = player:FindFirstChild("PlayerStats")
            if stats and stats:FindFirstChild("Stand") then
                if stats.Stand.Value == selectedTargetStand then
                    isFarmingItems = false
                    if farmThread then task.cancel(farmThread) farmThread = nil end
                    if farmItemBtn then
                        farmItemBtn.Text = "📦 ITEM FARM : ВЫКЛ"
                        farmItemBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
                    end
                    break
                end
            end
        end
        
        local char, rootPart = updateCharacter()
        if not char or not rootPart then task.wait(1) continue end
        
        local hum = char:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then
            player.CharacterAdded:Wait()
            task.wait(1)
            continue
        end
        
        local items = getSpawnedItems()
        if #items == 0 then
            task.wait(1.5)
            continue
        end
        
        table.sort(items, function(a, b)
            return getDistanceToItem(a.Model) < getDistanceToItem(b.Model)
        end)
        
        for _, item in ipairs(items) do
            if not isFarmingItems then break end
            collectItem(item.Model, item.Name, item.Prompt)
            task.wait(0.3)
        end
        task.wait(0.5)
    end
end

local function toggleItemFarm()
    local hasSelected = false
    for _, selected in pairs(selectedItems) do
        if selected then hasSelected = true break end
