local function SetupDistanceBypass()
    pcall(function()
        local oldMeta = getrawmetatable(Vector3.new())
        local oldIndex = oldMeta.__index
        setreadonly(oldMeta, false)
        
        oldMeta.__index = function(self, key)
            if key:lower() == "magnitude" and getcallingscript() and getcallingscript().Name == "ItemSpawn" then
                return 0
            end
            return oldIndex(self, key)
        end
        
        setreadonly(oldMeta, true)
    end)
end

