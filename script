local function fightNPC(npc, useStand)
    if not npc or not npc.Parent then return false end
    
    stopHeartbeat()
    startAttack()
    
    heartbeatConn = RunService.Heartbeat:Connect(function()
        if not active or (useStand and not standMode) or not npc or not npc.Parent then 
            stopAttack()
            return 
        end
        
        local hum = character and character:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 or not rootPart then 
            stopAttack()
            return 
        end
        
        local targetRoot = npc:FindFirstChild("HumanoidRootPart")
        if not targetRoot then return end

        if useStand then
            local head = npc:FindFirstChild("Head")
            if head then
                rootPart.CFrame = CFrame.new(head.Position + Vector3.new(0, 25, 0))
            end
            
            local currentStand = character:FindFirstChild("StandMorph")
            if currentStand then
                local standPos = targetRoot.Position + Vector3.new(0, -5, 0)
                local directionToTarget = (targetRoot.Position - standPos).Unit
                currentStand:SetPrimaryPartCFrame(
                    CFrame.new(standPos, standPos + directionToTarget)
                )
            end
        else
            local behind = targetRoot.Position - targetRoot.CFrame.LookVector * 4
            rootPart.CFrame = CFrame.new(behind, targetRoot.Position)
        end
    end)
    
    local startTime = os.clock()
    local died = false
    
    while active and (not useStand or standMode) and npc and npc.Parent do
        local hp = npc:FindFirstChild("Health")
        if not hp or hp.Value <= 0 then died = true break end
        
        local hum = character and character:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then break end
        
        if useStand and os.clock() % 2 < 0.1 and not isStandSummoned() then
            toggleStand()
            task.wait(1)
            if not attacking and active then startAttack() end
        end
        
        task.wait(0.1)
        if os.clock() - startTime > (useStand and 60 or 30) then break end
    end
    
    stopHeartbeat()
    stopAttack()
    task.wait(0.2)
    return died
end

local function summonStandWithCheck()
    toggleStand()
    task.wait(1.5)
    
    if isStandSummoned() then
        return true
    end

    local attempts = 0
    while attempts < 3 and active do
        attempts = attempts + 1
        resetCharacter()
        toggleStand()
        task.wait(1.5)
        
        if isStandSummoned() then
            return true
        end
    end
    
    return false
end

local function farmNPCs(name)
    while active and not standMode do
        local progress = getQuestProgress()
        
        if progress.Progress >= progress.Max and progress.Max > 0 then
            break
        end
        
        local hum = character and character:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then
            character = player.CharacterAdded:Wait()
            updateCharacter(character)
            stopAttack()
            task.wait(2)
        end
        
        local target = findNPC(name)
        if target then
            travel(target.HumanoidRootPart.Position)
            task.wait(0.3)
            if not active then break end
            if fightNPC(target, false) then RefreshQuests() end
            task.wait(0.5)
        else
            task.wait(3)
        end
    end
end

local function getGoodStand()
    while active do
        local stats = player:FindFirstChild("PlayerStats")
        if stats and stats:FindFirstChild("Stand") then
            local standVal = stats.Stand.Value

            if standVal ~= "None" then
                if badStands[standVal] then
                    if not (backpack:FindFirstChild("Rokakaka") or character:FindFirstChild("Rokakaka")) then
                        farmItem("Rokakaka")
                    end
                    useRoka()
                    task.wait(2)
                else
                    return standVal
                end
            else
                learnSkills()
                
                if not (backpack:FindFirstChild("Mysterious Arrow") or character:FindFirstChild("Mysterious Arrow")) then
                    farmItem("Mysterious Arrow")
                end
                useArrow()
                task.wait(2)

                local newStand = stats.Stand.Value
                if newStand ~= "None" and not badStands[newStand] then
                    resetCharacter()
                    return newStand
                end
            end
        end
        task.wait(2)
    end
end

local function farmWithStand(name)
    standMode = true
    
    while active and standMode do
        local hum = character and character:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then
            character = player.CharacterAdded:Wait()
            updateCharacter(character)
            stopAttack()
            continue
        end
        
        local progress = getQuestProgress()
        
        if progress.Progress >= progress.Max and progress.Max > 0 then
            break
        end

        local target = findNPC(name)
        if target then
            currentTarget = target
            
            if target:FindFirstChild("HumanoidRootPart") then
                travel(target.HumanoidRootPart.Position)
            end
            
            if not isStandSummoned() then
                if not summonStandWithCheck() then 
                    standMode = false 
                    break 
                end
            end
            
            if fightNPC(target, true) then RefreshQuests() end
            task.wait(0.5)
        else
            stopAttack()
            task.wait(1)
        end
    end
    stopStandMode()
end

