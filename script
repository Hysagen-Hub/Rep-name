    if inputKey == "" then
        statusLabel.Text = "Введите ключ!"
        return
    end

    isVerifying = true
    statusLabel.TextColor3 = Color3.fromRGB(255, 200, 80)
    statusLabel.Text = "Проверка ключа..."

    task.spawn(function()
        local success, response = pcall(function()
            return httpRequest({
                Url = WORKER_URL,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode({
                    key = inputKey,
                    hwid = getHWID()
                })
            })
        end)

        if success and response and response.StatusCode == 200 then
            local dataSuccess, data = pcall(function() return HttpService:JSONDecode(response.Body) end)
            if dataSuccess and data and data.success then
                statusLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
                statusLabel.Text = "✅ Успешно! Загрузка скрипта..."
                task.wait(1)
                
                keyGui:Destroy()
                loadMainScript()
            else
                statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
                statusLabel.Text = data and data.message or "Неверный ключ!"
                isVerifying = false
            end
        else
            statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            statusLabel.Text = "Ошибка сети/сервера"
            isVerifying = false
        end
