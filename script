local function CreateItemESP()
    -- Проверяем, активен ли ESP
    if _G.ItemESP_Active == nil then
        _G.ItemESP_Active = false
    end
    
    if _G.ItemESP_Active then
        return espInstance
    end
    
    -- Устанавливаем флаг
    _G.ItemESP_Active = true
    espTracker = {}
    setupTracker(espTracker)
    
    local espGui = Instance.new("BillboardGui")
    espGui.Name = "ItemESP"
    espGui.AlwaysOnTop = true
    espGui.Size = UDim2.new(0, 200, 0, 30)
    espGui.StudsOffset = Vector3.new(0, 2.5, 0)
    
    local textLabel = Instance.new("TextLabel")
    textLabel.BackgroundTransparency = 1
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
    textLabel.TextScaled = true
    textLabel.TextStrokeTransparency = 0.3
    textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    textLabel.Parent = espGui
    
    local function updateESP()
        for itemName, items in pairs(espTracker) do
            for _, prompt in pairs(items) do
                local parent = prompt.Parent
                if parent and parent:IsDescendantOf(workspace) then
                    local existingESP = parent:FindFirstChild("ItemESP")
                    if not existingESP then
                        local newESP = espGui:Clone()
                        newESP.Parent = parent
                        local label = newESP:FindFirstChildOfClass("TextLabel")
                        if label then
                            label.Text = itemName
                            if itemName:find("Arrow") or itemName:find("Mysterious") then
                                label.TextColor3 = Color3.fromRGB(255, 80, 80)
                            elseif itemName:find("Rib") or itemName:find("Cage") then
                                label.TextColor3 = Color3.fromRGB(200, 100, 255)
                            elseif itemName:find("Rokakaka") then
                                label.TextColor3 = Color3.fromRGB(80, 255, 80)
                            elseif itemName:find("Dio") or itemName:find("Diary") then
                                label.TextColor3 = Color3.fromRGB(255, 215, 0)
                            elseif itemName:find("Stone") then
                                label.TextColor3 = Color3.fromRGB(255, 140, 0)
                            elseif itemName:find("Steel") then
                                label.TextColor3 = Color3.fromRGB(192, 192, 192)
                            elseif itemName:find("Diamond") then
                                label.TextColor3 = Color3.fromRGB(0, 255, 255)
                            else
                                label.TextColor3 = Color3.fromRGB(255, 255, 100)
                            end
                        end
                    end
                end
            end
        end
    end
    
    -- Первое обновление
    updateESP()
    
    local espUpdateThread = task.spawn(function()
        while _G.ItemESP_Active do
            task.wait(1)
            updateESP()
        end
    end)
    
    espInstance = {
        Disable = function()
            _G.ItemESP_Active = false
            if espUpdateThread then 
                pcall(function() task.cancel(espUpdateThread) end)
                espUpdateThread = nil
            end
            local container = getItemContainer()
            if container then
                for _, item in pairs(container:GetChildren()) do
                    local esp = item:FindFirstChild("ItemESP")
                    if esp then esp:Destroy() end
                end
            end
            espTracker = {}
            espInstance = nil
        end
    }
    
    return espInstance
end

