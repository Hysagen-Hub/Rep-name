local function fightNPC(npc, useStand)
    if not npc or not npc.Parent then return false end
    stopHeartbeat()
    startAttack()
    
    local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    heartbeatConn = RunService.Heartbeat:Connect(function()
        if not mainActive or (useStand and not standMode) or not npc or not npc.Parent then
            stopAttack()
            return
        end
        local hum = player.Character and player.Character:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 or not rootPart then
            stopAttack()
            return
        end
        local targetRoot = npc:FindFirstChild("HumanoidRootPart")
        if not targetRoot then return end
        if useStand then
            local head = npc:FindFirstChild("Head")
            if head then
                rootPart.CFrame = CFrame.new(head.Position + Vector3.new(0, 25, 0))
            end
            local currentStand = player.Character:FindFirstChild("StandMorph")
            if currentStand then
                local standPos = targetRoot.Position + Vector3.new(0, -5, 0)
                currentStand:SetPrimaryPartCFrame(CFrame.new(standPos, targetRoot.Position))
            end
        else
            local behind = targetRoot.Position - targetRoot.CFrame.LookVector * 4
            rootPart.CFrame = CFrame.new(behind, targetRoot.Position)
        end
    end)
    
    local startTime = os.clock()
    local died = false
    while mainActive and (not useStand or standMode) and npc and npc.Parent do
        local hp = npc:FindFirstChild("Health")
        if not hp or hp.Value <= 0 then died = true break end
        local hum = player.Character and player.Character:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then break end
        if useStand and os.clock() % 2 < 0.1 and not isStandSummoned() then
            toggleStand()
            task.wait(1)
            if not attacking and mainActive then startAttack() end
        end
        task.wait(0.1)
        if os.clock() - startTime > (useStand and 60 or 30) then break end
    end
    stopHeartbeat()
    stopAttack()
    task.wait(0.2)
    return died
end

local function farmNPCs(name)
    while mainActive and not standMode do
        local progress = getQuestProgress()
        if progress.Progress >= progress.Max and progress.Max > 0 then break end
        local hum = player.Character and player.Character:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then
            resetCharacter()
            stopAttack()
            task.wait(2)
        end
        local target = findNPC(name)
        if target then
            local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if rootPart and target:FindFirstChild("HumanoidRootPart") then
                travelToPositionSmooth(target.HumanoidRootPart.Position, 30)
            end
            task.wait(0.3)
            if not mainActive then break end
            if fightNPC(target, false) then refreshQuests() end
            task.wait(0.5)
        else
            task.wait(3)
        end
    end
end

local function farmWithStand(name)
    standMode = true
    while mainActive and standMode do
        local hum = player.Character and player.Character:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then
            resetCharacter()
            stopAttack()
            continue
        end
        local progress = getQuestProgress()
        if progress.Progress >= progress.Max and progress.Max > 0 then break end
        local target = findNPC(name)
        if target then
            currentTarget = target
            local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if rootPart and target:FindFirstChild("HumanoidRootPart") then
                travelToPositionSmooth(target.HumanoidRootPart.Position, 30)
            end
            if not isStandSummoned() then
                if not summonStandWithCheck() then
                    standMode = false
                    break
                end
            end
            if fightNPC(target, true) then refreshQuests() end
            task.wait(0.5)
        else
            stopAttack()
            task.wait(1)
        end
    end
    stopStandMode()
end

local function stopMainFarm()
    mainActive = false
    stopRequested = true
    stopAttack()
    stopStandMode()
    if mainFarmThread then
        local thread = mainFarmThread
        mainFarmThread = nil
        if coroutine.running() ~= thread then
            pcall(function() task.cancel(thread) end)
        end
    end
end

