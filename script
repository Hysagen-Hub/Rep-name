local function getItemPosition(model)
    if not model then return nil end
    local part = model:IsA("BasePart") and model or model.PrimaryPart or model:FindFirstChildOfClass("BasePart")
    return part and part.Position or nil
end

local function getDistanceToItem(model)
    local _, rootPart = updateCharacter()
    if not rootPart or not rootPart.Parent then return math.huge end
    local pos = getItemPosition(model)
    return pos and (rootPart.Position - pos).Magnitude or math.huge
end

local function travelToPositionSmooth(pos, speed)
    speed = speed or 50
    local _, rootPart = updateCharacter()
    if not rootPart or not rootPart.Parent then return false end
    
    local distance = (rootPart.Position - pos).Magnitude
    if distance < ACTIVATION_DISTANCE then return true end
    
    wasAnchored = rootPart.Anchored
    rootPart.Anchored = true
    
    local success = false
    pcall(function()
        local start = rootPart.Position
        local dir = (pos - start)
        local dist = dir.Magnitude
        local steps = math.max(1, math.ceil(dist / speed))
        local stepVec = dir / steps
        
        for i = 1, steps do
            if not mainActive and not isFarmingItems then return end
            if not rootPart or not rootPart.Parent then return end
            
            local newPos = rootPart.Position + stepVec
            local remaining = (pos - newPos).Magnitude
            
            if remaining < 5 then
                rootPart.CFrame = CFrame.new(pos)
                break
            end
            
            rootPart.CFrame = CFrame.new(newPos)
            task.wait()
        end
        
        rootPart.CFrame = CFrame.new(pos)
        task.wait(0.1)
        success = true
    end)
    
    rootPart.Anchored = wasAnchored
    wasAnchored = false
    return success
end

