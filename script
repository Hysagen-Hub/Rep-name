local function getGoodStand()
    while mainActive do
        local stats = player:FindFirstChild("PlayerStats")
        if stats and stats:FindFirstChild("Stand") then
            local standVal = stats.Stand.Value
            if standVal ~= "None" then
                if badStands[standVal] then
                    if not (player.Backpack:FindFirstChild("Rokakaka") or (player.Character and player.Character:FindFirstChild("Rokakaka"))) then
                        farmSpecificItem("Rokakaka")
                    end
                    useItemWithGUI("Rokakaka")
                    task.wait(2)
                else
                    return standVal
                end
            else
                learnSkills()
                if not (player.Backpack:FindFirstChild("Mysterious Arrow") or (player.Character and player.Character:FindFirstChild("Mysterious Arrow"))) then
                    farmSpecificItem("Mysterious Arrow")
                end
                useItemWithGUI("Mysterious Arrow")
                task.wait(2)
                local newStand = stats.Stand.Value
                if newStand ~= "None" and not badStands[newStand] then
                    resetCharacter()
                    return newStand
                end
            end
        end
        task.wait(2)
    end
end

