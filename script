local function updateCharacter(newChar)
    character = newChar or player.Character
    if not character then return end
    
    rootPart = character:WaitForChild("HumanoidRootPart", 5)
    backpack = player:WaitForChild("Backpack", 5)
    RE = character:WaitForChild("RemoteEvent", 5)
    RF = character:WaitForChild("RemoteFunction", 5)
    QuestsRF = character:FindFirstChild("QuestsRemoteFunction") or ReplicatedStorage:FindFirstChild("QuestsRemoteFunction")
end

local function resetCharacter()
    updateCharacter(player.Character)
    if character then
        local hum = character:FindFirstChildOfClass("Humanoid") or character:FindFirstChild("Humanoid")
        if hum then
            hum.Health = 0
        end
    end
    local newChar = player.CharacterAdded:Wait()
    updateCharacter(newChar)
    task.wait(1)
end

if player.Character then updateCharacter(player.Character) end

local function RefreshQuests()
    if QuestsRF then
        pcall(function() QuestsRF:InvokeServer({"ReturnData"}) end)
