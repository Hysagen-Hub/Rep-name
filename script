                        local esp = item:FindFirstChild("ItemESP")
                        if esp then
                            esp:Destroy()
                        end
                    end
                end
            end
            _G.ItemESP_Items = {}
            espInstance = nil
        end
    }
    
    return espInstance
end

local function getItemPosition(model)
    if not model then return nil end
    local part = model:IsA("BasePart") and model or model.PrimaryPart or model:FindFirstChildOfClass("BasePart")
    return part and part.Position or nil
end

local function getDistanceToItem(model)
    local _, rootPart = updateCharacterForItems()
    if not rootPart or not rootPart.Parent then
        return math.huge
    end
    
    local itemPos = getItemPosition(model)
    if not itemPos then
        return math.huge
    end
    
    return (rootPart.Position - itemPos).Magnitude
end

local function activateRemoteEvents(model, prompt)
    if not model or not model:IsDescendantOf(workspace) then
        return false
    end
    
    local remoteEvents = {}
    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("RemoteEvent") then
            table.insert(remoteEvents, descendant)
        end
    end
    
    if #remoteEvents > 0 then
        for _, remote in ipairs(remoteEvents) do
            if not isFarmingItems or not model.Parent then break end
            
            for i = 1, 3 do
                pcall(function()
                    remote:FireServer()
                    remote:FireServer(model)
                    remote:FireServer(prompt)
                end)
                task.wait(0.15)
            end
        end
        return true
    end
    return false
end

local function collectItem(model, name, prompt)
    if not model or not model:IsDescendantOf(workspace) then 
        return false 
    end
    
    local distance = getDistanceToItem(model)
    
    if distance > ACTIVATION_DISTANCE then
        local part = model:IsA("BasePart") and model or model.PrimaryPart or model:FindFirstChildOfClass("BasePart")
        if part then
            if travelToPositionAnchored(part.Position + Vector3.new(0, 1, 0)) then
                task.wait(0.3)
                local newDistance = getDistanceToItem(model)
                if newDistance <= ACTIVATION_DISTANCE then
                    return activateRemoteEvents(model, prompt)
                end
            end
        end
        return false
    else
        return activateRemoteEvents(model, prompt)
    end
end

local function getSpawnedItems()
    local availableItems = {}
    for name, prompts in pairs(itemFarmTable) do
        if selectedItems[name] then
            for _, prompt in ipairs(prompts) do
                if prompt and prompt:IsDescendantOf(workspace) then
                    local parent = prompt.Parent
                    if parent then
                        table.insert(availableItems, {
                            Name = name,
                            Prompt = prompt,
                            Model = parent
                        })
                    end
                end
            end
        end
    end
    return availableItems
end

local function startItemFarmLoop()
    while isFarmingItems do
        local char, rootPart = updateCharacterForItems()
        if not char or not rootPart then
            task.wait(1)
            continue
        end
        
        local hum = char:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then
            player.CharacterAdded:Wait()
            task.wait(1)
            continue
        end
        
        local items = getSpawnedItems()
        if #items == 0 then
            task.wait(1.5)
            continue
        end
        
        table.sort(items, function(a, b)
            local distA = getDistanceToItem(a.Model)
            local distB = getDistanceToItem(b.Model)
            return distA < distB
        end)
        
        for _, item in ipairs(items) do
            if not isFarmingItems then break end
            
            collectItem(item.Model, item.Name, item.Prompt)
            task.wait(0.3)
        end
        
        task.wait(0.5)
    end
end

local function toggleItemFarm()
    local hasSelected = false
    for _, selected in pairs(selectedItems) do
        if selected then
            hasSelected = true
            break
        end
    end
    
    if not hasSelected then
        return false
    end
    
    isFarmingItems = not isFarmingItems
    
    if isFarmingItems then
        farmThread = task.spawn(startItemFarmLoop)
    else
        if farmThread then
            task.cancel(farmThread)
            farmThread = nil
        end
    end
    
    return true
end

