local function updateCharacterForItems()
    local char = player.Character
    if not char then return nil, nil, nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    local backpack = player:FindFirstChild("Backpack")
    return char, root, backpack
end

local function travelToPositionAnchored(pos)
    local char, rootPart = updateCharacterForItems()
    if not rootPart or not rootPart.Parent then 
        return false 
    end
    
    wasAnchored = rootPart.Anchored
    rootPart.Anchored = true
    
    local success = false
    
    pcall(function()
        local start = rootPart.Position
        local dir = (pos - start)
        local dist = dir.Magnitude
        
        if dist < ACTIVATION_DISTANCE then
            success = true
            return
        end
        
        local steps = math.max(1, math.ceil(dist / 50))
        local stepVec = dir / steps
        
        for i = 1, steps do
            if not isFarmingItems or not rootPart or not rootPart.Parent then 
                return 
            end
            rootPart.CFrame = CFrame.new(rootPart.Position + stepVec)
            task.wait(0.05)
        end
        rootPart.CFrame = CFrame.new(pos)
        task.wait(0.05)
        success = true
    end)
    
    rootPart.Anchored = wasAnchored
    wasAnchored = false
    
    return success
end

