local function RegisterItemForFarm(item)
    if item.ClassName ~= "ProximityPrompt" then
        return
    end
    
    if not item.Parent:FindFirstChild("PointLight", true) then
        return
    end
    
    local itemName = item.ObjectText or "Unknown"
    
    if not itemFarmTable[itemName] then
        itemFarmTable[itemName] = {}
    end
    
    table.insert(itemFarmTable[itemName], item)
    
    item.AncestryChanged:Connect(function()
        if not item:IsDescendantOf(workspace) then
            if itemFarmTable[itemName] then
                for i, v in pairs(itemFarmTable[itemName]) do
                    if v == item then
                        table.remove(itemFarmTable[itemName], i)
                        break
                    end
                end
                if #itemFarmTable[itemName] == 0 then
                    itemFarmTable[itemName] = nil
                end
            end
        end
    end)
end

local function InitItemTrackerForFarm()
    itemFarmTable = {}
    _G.ItemFarm_Items = itemFarmTable
    
    local itemsContainer = workspace:FindFirstChild("Item_Spawns")
    if itemsContainer then
        itemsContainer = itemsContainer:FindFirstChild("Items")
        if itemsContainer then
            for _, descendant in ipairs(itemsContainer:GetDescendants()) do
                if descendant.ClassName == "ProximityPrompt" then
                    RegisterItemForFarm(descendant)
                end
            end
            
            if not getgenv().farm_item_added_conn then
                getgenv().farm_item_added_conn = itemsContainer.DescendantAdded:Connect(function(descendant)
                    if descendant.ClassName == "ProximityPrompt" then
                        RegisterItemForFarm(descendant)
                    end
                end)
            end
            
            if not getgenv().farm_item_removed_conn then
                getgenv().farm_item_removed_conn = itemsContainer.DescendantRemoving:Connect(function(descendant)
                    if descendant.ClassName == "ProximityPrompt" then
                        local itemName = descendant.ObjectText or "Unknown"
                        if itemFarmTable[itemName] then
                            for i, v in pairs(itemFarmTable[itemName]) do
                                if v == descendant then
                                    table.remove(itemFarmTable[itemName], i)
                                    break
                                end
                            end
                            if #itemFarmTable[itemName] == 0 then
                                itemFarmTable[itemName] = nil
                            end
                        end
                    end
                end)
            end
        end
    end
end

